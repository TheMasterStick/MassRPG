{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "massrpg://schemas/recipe.schema.json",
  "title": "MassRPG Recipe Draft",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "skill", "levelRequired", "inputs", "outputItemId", "outputQuantity", "xp", "durationMilliseconds", "category", "canBurn", "failureXpFraction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{1,79}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "skill": { "enum": ["Cooking", "Firemaking", "Smithing", "Crafting", "Fletching", "Herblore", "Construction"] },
    "levelRequired": { "type": "integer", "minimum": 1, "maximum": 300 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["itemId", "quantity"],
        "properties": {
          "itemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
          "quantity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "outputItemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "outputQuantity": { "type": "integer", "minimum": 1 },
    "xp": { "type": "integer", "minimum": 0 },
    "durationMilliseconds": { "type": "integer", "minimum": 1 },
    "category": { "type": "string", "maxLength": 100 },
    "stationId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "toolRequiredId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "canBurn": { "type": "boolean" },
    "failureOutputItemId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "failureXpFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "editorState": { "enum": ["draft", "ready-for-review"] }
  },
  "additionalProperties": false
}
